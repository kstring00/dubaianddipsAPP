# Preview mode shows sample rewards content while Toast is not live.
# Production EAS builds override this to false.
EXPO_PUBLIC_PREVIEW_MODE=true

# Main Toast Online Ordering URL — leave blank until the restaurant activates it.
EXPO_PUBLIC_TOAST_ORDER_URL=

# Optional direct Toast links for categories/items.
EXPO_PUBLIC_TOAST_FRAPPES_URL=
EXPO_PUBLIC_TOAST_MATCHA_URL=
EXPO_PUBLIC_TOAST_COFFEE_URL=
EXPO_PUBLIC_TOAST_FEATURED_URL=

# Optional Toast loyalty/account destination.
EXPO_PUBLIC_TOAST_REWARDS_URL=
